# Local development default. Change to the production origin for production builds.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase service key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Stripe TEST mode for local development. Keep all secret values server-side.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_with_monthly_test_price_id

# Production value:
# NEXT_PUBLIC_APP_URL=https://snaptextai.app

# Existing monthly Pro price remains configured as STRIPE_PRO_PRICE_ID.
# Create a recurring EUR yearly Price (€29.99 every 12 months) in Stripe Test mode,
# then set its Price ID here. Never use a Live-mode Price ID in development.
STRIPE_YEARLY_PRICE_ID=price_replace_with_test_price_id
