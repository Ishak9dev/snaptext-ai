# Canonical origin used for metadata, authentication callbacks, and billing redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL remains supported as a legacy fallback.

# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase service key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Required for OCR, image description, document analysis, receipt scanning, and form extraction.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Required for background removal.
REMOVE_BG_API_KEY=your-remove-bg-api-key

# Contact delivery uses a verified sender in Resend. Messages go to the support email in code.
RESEND_API_KEY=re_replace_me
CONTACT_FROM_EMAIL=SnapTextAI <support@snaptextai.app>

# Stripe TEST mode for local development. Secret keys remain server-side.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me
STRIPE_PRO_PRICE_ID=price_replace_with_monthly_test_price_id

# For Vercel Production, set the same variable names to matching LIVE values:
# STRIPE_SECRET_KEY=sk_live_... (Secret)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... (Config; browser-visible)
# STRIPE_WEBHOOK_SECRET=whsec_... (Secret for the production webhook endpoint)
# STRIPE_PRO_PRICE_ID=price_... (active recurring monthly LIVE Price)
# STRIPE_YEARLY_PRICE_ID=price_... (active recurring yearly LIVE Price)
# The application rejects mixed key/Price modes and refuses test keys in Production.

# Production canonical value (used for checkout, portal returns, and metadata):
# NEXT_PUBLIC_SITE_URL=https://www.snaptextai.app

# Existing monthly Pro price remains configured as STRIPE_PRO_PRICE_ID.
# Create the yearly Price in the same Stripe mode as STRIPE_SECRET_KEY and set its
# Price ID here. Never use a Live-mode Price ID in development.
STRIPE_YEARLY_PRICE_ID=price_replace_with_test_price_id

# Set a strong random value in Vercel for the scheduled image-expiry route.
# Do not commit the value. The cron route fails closed when it is missing.
# CRON_SECRET=
